# Supabase Configuration
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Waitlist form destination — 'console' | 'webhook' | 'proxy'
#   console  dev default; logs the payload, never fails
#   webhook  POSTs straight from the browser to VITE_WAITLIST_ENDPOINT
#   proxy    POSTs to /api/waitlist, which forwards server-side
# Prefer 'proxy' for GoHighLevel: it avoids CORS preflight and keeps the
# webhook URL out of the public bundle.
VITE_WAITLIST_MODE=console

# Only used when VITE_WAITLIST_MODE=webhook.
# NOTE: VITE_ vars are inlined into the client bundle and are readable by
# anyone. Use proxy mode if the URL needs to stay private.
VITE_WAITLIST_ENDPOINT=
